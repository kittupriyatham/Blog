# Blog - environment configuration
# Copy to `.env` (it is git-ignored) and fill in. See app.py for defaults.
# Schema is auto-created on first boot (ensure_schema in src/db/__init__.py); no init script needed.

# === Flask / runtime ===
SECRET_KEY=a-long-random-string   # signs sessions; rotate per deploy
PORT=5000                                      # host port for `python app.py` (FLASK_RUN_PORT also honoured)
FLASK_DEBUG=0

# === Admin login (POST /login -> BLOG_ADMIN_USERNAME / BLOG_ADMIN_PASSWORD) ===
BLOG_ADMIN_USERNAME=admin # you can change this value too if you wish to.
BLOG_ADMIN_PASSWORD=change-me

# === Public site URL (canonical links + syndication) ===
SITE_URL=                                      # e.g. https://blog.example.com
SITE_URL_ALT=                                  # alternative/next site URL (recorded only; canonical links still use SITE_URL)

# === Uploads ===
UPLOAD_TOKEN=                                  # shared secret for unauthenticated media uploads (else admin-only)

# === First-party analytics (see /admin/analytics) ===
ANALYTICS_STORE=file                           # file (analytics.jsonl) or mongo
ANALYTICS_IP_SALT=blog-analytics               # per-deployment salt for the hashed IP
ANALYTICS_GEO=0                                # 1 = resolve visitor country/state at the beacon (ip-api, cached, no raw IP stored)

# === Database (optional) ===
MONGO_URI=                                     # e.g. mongodb://localhost:27017/blog_db
# With MONGO_URI set the app uses MongoEngine directly. Leave empty -> the app
# falls back to a local mongod at mongodb://127.0.0.1:27017/blog_db (start one
# with `docker run -d -p 27017:27017 mongo`). The in-memory `mongomock` fallback
# is no longer supported (MongoEngine cannot drive it).

# LinkedIn - direct API adapter (src/syndication/linkedin.py reads exactly these two)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=                            # 1 = dev reloader + detailed error pages (keep 0 in prod)
# Optional: LinkedIn OAuth (auth-code + refresh) so the token stops expiring.
# Create an app at linkedin.com/developers, add the redirect URL below to its
# whitelist, and request the `w_member_social` scope (a refresh token needs it).
#   python -m src.syndication.linkedin_token        # prints the authorize URL
#   python -m src.syndication.linkedin_token <code> # exchanges + stores the token
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=                          # e.g. http://127.0.0.1:5000/linkedin/callback

# SocialAPI.ai - one key covers Facebook, Instagram, YouTube, X/Twitter, Bluesky
# and Pinterest. Accounts are managed in the SocialAPI dashboard, not here; the
# platform list defaults to facebook,instagram,youtube,twitter,bluesky,pinterest
# (see DEFAULT_PLATFORMS in src/syndication/socialapi.py).
SOCIALAPI_KEY=

# Pinterest has no default board - a Pin without a board_id is rejected. This is
# the "Blog" board on the connected account. If it is removed, publishing falls
# back to the account's first board, creating one only if there is none.
SOCIALAPI_BOARD_PINTEREST=

# === Notifications (Telegram webhook alerts, optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Medium - published by driving the editor in a real browser, because Medium has
# no write API and its importer cannot reach localhost.
# MEDIUM_STATE_FILE is a Playwright storage-state export made once from a
# logged-in browser:  playwright-cli -s=<session> state-save data/medium_auth.json
# That file holds live session cookies - it is git-ignored, never commit it.
# Stories are saved as DRAFTS; you review and publish them by hand.
MEDIUM_STATE_FILE=data/medium_auth.json
# "0" shows the browser while it works (useful the first time), "1" is headless.
MEDIUM_HEADLESS=1
# chrome reuses the installed browser, so nothing extra is downloaded.
MEDIUM_CHANNEL=chrome

# X / Twitter has no free API tier (pay-per-use since Feb 2026), so it needs two
# separate switches:
#
# TWITTER_API_CREDIT - is there credit on the X API?
#   1 (default) = the X checkbox is offered.
#   0           = the checkbox is greyed out, so nothing can be posted to X.
#                 Set this to 0 when credit runs out.
#
# TWITTER_SUBSCRIPTION - do you have an X Premium subscription?
#   1 = articles may be syndicated to X (X Articles are a Premium feature).
#   0 (default) = X is not offered for articles at all; short posts are unaffected.
TWITTER_API_CREDIT=0
TWITTER_SUBSCRIPTION=0

# X / Twitter BYOK credentials. These belong in the SocialAPI dashboard under
# Settings -> Twitter integration (SocialAPI holds them and posts on your
# behalf). Nothing in this repo reads them, so they are recorded here only so
# they are not lost - X shows the secret once.
# Consumer Key=
# Secret Key=
# BEARER_TOKEN=

# === Storage backends (local vs cloud) ===
DEFAULT_BACKEND=local                          # local | cloud (applies to media + database unless overridden)
MEDIA_BACKEND=                                 # optional override for media (local | cloud)
DB_BACKEND=                                    # optional override for the database (local | cloud)
# Cloud media (used when MEDIA_BACKEND=cloud) — the platform's upload API / URL; no cloud SDK.
MEDIA_ADAPTER=http                             # adapter name (http = generic config-driven uploader)
MEDIA_UPLOAD_URL=                              # upload endpoint or pre-signed URL
MEDIA_UPLOAD_METHOD=PUT                        # PUT | POST
MEDIA_AUTH_HEADER=                             # e.g. Authorization
MEDIA_TOKEN=                                   # value sent in MEDIA_AUTH_HEADER
MEDIA_FORM_FIELD=                              # multipart field name (POST APIs)
MEDIA_PUBLIC_BASE=                             # base URL used to build public links