# Environment Configuration for MyPortFolio
# Only entries actually read by app.py / src/syndication are set here.
# Copy to `.env` (it is git-ignored) and fill in your real credentials.

# Secret key used for securely signing the session cookies
SECRET_KEY=
PORT=                                          # host port for `python app.py` (FLASK_RUN_PORT also honoured)
FLASK_DEBUG=

# Admin Login Credentials for the Blog
BLOG_ADMIN_USERNAME=
BLOG_ADMIN_PASSWORD=

# === Public site URL (canonical links + syndication) ===
SITE_URL=                                      # e.g. https://blog.potluri-krishna-priyatham.tech
SITE_URL_ALT=                                  # alternative/next site URL (recorded only; canonical links still use SITE_URL)

# === Uploads ===
UPLOAD_TOKEN=                                  # shared secret for unauthenticated media uploads (else admin-only)

# === First-party analytics (see /admin/analytics) ===
ANALYTICS_STORE=                               # file (analytics.jsonl) or mongo
ANALYTICS_IP_SALT=                             # per-deployment salt for the hashed IP
ANALYTICS_GEO=                                 # 1 = resolve visitor country/state at the beacon (ip-api, cached, no raw IP stored)

# === Database (local vs cloud) ===
LOCAL_MONGO_URI=
ATLAS_MONGO_URI=                               # mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
ATLAS_MONGO_NAME=
ATLAS_MONGO_PASS=
# Optional master override: if set, overrides both LOCAL and ATLAS URIs
# MONGO_URI=

# LinkedIn - direct API adapter (src/syndication/linkedin.py reads exactly these two)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=                           # urn:li:person:<id>

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=                         # e.g. https://www.linkedin.com/developers/tools/oauth/redirect or /linkedin/callback

# Leave BLANK to publish as YOU (personal profile) - the default. Set an
# Organization URN (urn:li:organization:<id>) to publish AS that Page instead
# (required for the Page analytics endpoint).
LINKEDIN_ORGANIZATION_URN=

# SocialAPI.ai - one key covers Facebook, Instagram, YouTube, X/Twitter, Bluesky
# and Pinterest. Accounts are managed in the SocialAPI dashboard, not here; the
# platform list defaults to facebook,instagram,youtube,twitter,bluesky,pinterest
# (see DEFAULT_PLATFORMS in src/syndication/socialapi.py).
SOCIALAPI_KEY=

# Pinterest has no default board - a Pin without a board_id is rejected. This is
# the "Blog" board on the connected account. If it is removed, publishing falls
# back to the account's first board, creating one only if there is none.
SOCIALAPI_BOARD_PINTEREST=

# When a post is longer than a platform's character limit, it is rewritten to fit
# rather than trimmed (see src/syndication/rewrite.py). Uses GEMINI_API_KEY.
GEMINI_API_KEY=
REWRITE_MODEL=

# YouTube upload defaults - pre-fill the /youtube/<post_id> form only. The
# author can override either value per video, and that choice is what is stored
# and published. YOUTUBE_CATEGORY is a YouTube category id (22 = People & Blogs);
# YOUTUBE_VISIBILITY is public | unlisted | private. Both fall back to the
# SocialAPI defaults (22 / public) when unset or blank.
YOUTUBE_CATEGORY=
YOUTUBE_VISIBILITY=

# === Notifications (Telegram webhook alerts, optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Medium - published by driving the editor in a real browser, because Medium has
# no write API and its importer cannot reach localhost.
# Session cookies are stored in MongoDB (`secrets` collection, _id "medium_auth")
# with local fallback to data/medium_auth.json if present.
# Stories are saved as DRAFTS; you review and publish them by hand.
# "0" shows the browser while it works (useful the first time), "1" is headless.
MEDIUM_HEADLESS=
# chrome reuses the installed browser, so nothing extra is downloaded.
MEDIUM_CHANNEL=

# X / Twitter has no free API tier (pay-per-use since Feb 2026), so it needs two
# separate switches:
#
# TWITTER_API_CREDIT - is there credit on the X API?
#   1 (default) = the X checkbox is offered.
#   0           = the checkbox is greyed out, so nothing can be posted to X.
#                 Set this to 0 when credit runs out.
#
# TWITTER_SUBSCRIPTION - do you have an X Premium subscription?
#   1 = articles may be syndicated to X (X Articles are a Premium feature).
#   0 (default) = X is not offered for articles at all; short posts are unaffected.
TWITTER_API_CREDIT=
TWITTER_SUBSCRIPTION=

# X / Twitter BYOK credentials. These belong in the SocialAPI dashboard under
# Settings -> Twitter integration (SocialAPI holds them and posts on your
# behalf). Nothing in this repo reads them, so they are recorded here only so
# they are not lost - X shows the secret once.
# Consumer Key=
# Secret Key=
# BEARER_TOKEN=

# === Storage backends (local vs cloud) ===
DEFAULT_BACKEND=                               # local | cloud (applies to media + database unless overridden)
# Optional overrides (local | cloud)                       
MEDIA_BACKEND=                                                 
DB_BACKEND=                                                  
MEDIA_ADAPTER=                                          
                                                                        
# Cloudflare R2 (used when MEDIA_ADAPTER=r2) — S3-compatible object storage, signed
# with the standard library (no boto3).                             
R2_ACCOUNT_ID=                                 # Cloudflare account id (the bucket's owner)
R2_ACCESS_KEY_ID=                              # the R2 API token's access key id
R2_SECRET_ACCESS_KEY=                          # the R2 API token's secret
R2_BUCKET=                                     # the bucket name
R2_PUBLIC_BASE=                                # public base the files are served from, e.g. https://pub-<id>.r2.dev (no trailing slash)

# S3 Compatibility / Direct API Reference
R2_S3_ENDPOINT=                                # e.g. https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_API_TOKEN=

# POSSE Syndication (Dev.to & Hashnode)
DEVTO_API_KEY=
HASHNODE_ACCESS_TOKEN=
HASHNODE_PUBLICATION_ID=